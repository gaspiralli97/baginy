<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/login.css" />

<body>
  <form class="login-container" action="/admin/login" METHOD="POST">

    <!-- animated background -->
    <div class="bg-lines"></div>
    <div class="bg-shapes">
      <span class="shape s1"></span>
      <span class="shape s2"></span>
      <span class="shape s3"></span>
      <span class="shape s4"></span>
      <span class="shape s5"></span>
      <span class="shape s6"></span>
    </div>

    <!-- brand -->
    <div class="brand-label">VELMORA</div>

    <div class="login-frame">
      <div class="login-top">
        <span>Enter</span>
        <div>Go back <a href="/admin">Home</a></div>
        <p>
          Not registered yet?
          <a href="/admin/signup">Signup</a>
        </p>
      </div>
      <div class="login-input-frame">
        <div class="login-input-container">
          <label>Seller *</label>
          <input
            type="text"
            name="memberNick"
            class="member-nick"
            placeholder="Username"
            value=""
            required
          />
        </div>
        <div class="login-input-container">
          <label>Password *</label>
          <input
            type="password"
            name="memberPassword"
            class="member-password"
            placeholder="Password"
            value=""
            required
          />
        </div>
      </div>
      <button class="login-btn btn" name="login" type="submit">LOGIN</button>
    </div>
  </form>
</body>

<%- include('includes/footer') %>
