<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/users.css" />

<body>
  <div class="users-container">
    <% if(!member) { %>
    <div class="navigation-menu">
      <ul class="nav">
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link <%= path === '/' ? 'active' : '' %>" href="/admin/">Home</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link <%= path.startsWith('/signup') ? 'active' : '' %>" href="/admin/signup">SignUp</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link <%= path.startsWith('/login') ? 'active' : '' %>" href="/admin/login">Login</a>
        </li>
      </ul>
    </div>

    <div class="users-frame">
      <div class="not-auth-card">
        <span class="not-auth-txt">Please login first!</span>
        <a href="/admin/login" class="btn-login-link">Go to Login</a>
      </div>
    </div>

    <% } else { %>
    <div class="navigation-menu">
      <ul class="nav">
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link <%= path === '/' ? 'active' : '' %>" href="/admin/">Home</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link <%= path.startsWith('/product') ? 'active' : '' %>" href="/admin/product/all">Product List</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link <%= path.startsWith('/user') ? 'active' : '' %>" href="/admin/user/all">Users</a>
        </li>
        <li
          class="nav-item"
          style="cursor: pointer"
          onclick="return confirm('Do you really want to logout?')"
        >
          <a class="nav-link" href="/admin/logout">Logout</a>
        </li>
      </ul>
    </div>

    <div class="users-frame">
      <div class="page-title-row">
        <div class="page-title-left">
          <span class="page-title">Users</span>
          <span class="page-subtitle">Manage and monitor all registered users</span>
        </div>
      </div>

      <div class="board">
        <div class="user-table">
          <div class="table-header-row">
            <span class="header-name">All Users</span>
          </div>
          <div class="table-responsive-wrap">
            <table class="table table-hover mb-0">
              <thead>
                <tr>
                  <th scope="col">No</th>
                  <th scope="col">Name</th>
                  <th scope="col">Phone</th>
                  <th scope="col">Status</th>
                </tr>
              </thead>

              <% users.map(function(value, index) { %>
                <tbody>
                  <td><%= index + 1 %></td>
                  <td><%= value.memberNick %></td>
                  <td><%= value.memberPhone %></td>
                  <td>
                    <select class="spec-select member-status" id="<%= value._id%>">
                      <option value="ACTIVE" <%= value.memberStatus === `ACTIVE` ? `selected`: `` %>>ACTIVE</option>
                      <option value="BLOCK" <%= value.memberStatus === `BLOCK` ? `selected`: `` %>>BLOCK</option>
                      <option value="DELETE"<%= value.memberStatus === `DELETE` ? `selected`: `` %>>DELETE</option>
                    </select>
                  </td>
                </tbody>
              <% }) %>

            </table>
          </div>
        </div>
      </div>
    </div>
    <% } %>
  </div>

  <script type="text/javascript" src="/js/users.js"></script>
</body>

<%- include('includes/footer') %>
